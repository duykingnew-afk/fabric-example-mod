{
	"schemaVersion": 1,
	"id": "pocketfsr",
	"version": "${version}",
	"name": "Pocket FSR",
	"description": "A lightweight FSR 1.0 style upscaler for phones and tablets. Renders the world at a lower resolution and upscales it with plain OpenGL: no native libraries, no Vulkan.",
	"authors": [
		"duykingnew-afk"
	],
	"contributors": [
		"Based on the idea of Super Resolution by 187J3X1-114514 (GPL-3.0)",
		"FSR 1.0 EASU/RCAS algorithms by AMD (MIT)"
	],
	"contact": {
		"homepage": "https://github.com/duykingnew-afk/fabric-example-mod",
		"sources": "https://github.com/duykingnew-afk/fabric-example-mod",
		"issues": "https://github.com/duykingnew-afk/fabric-example-mod/issues"
	},
	"license": "GPL-3.0-or-later",
	"icon": "assets/pocketfsr/icon.png",
	"environment": "client",
	"entrypoints": {
		"client": [
			"com.duykingnew.pocketfsr.PocketFsrClient"
		]
	},
	"mixins": [
		{
			"config": "pocketfsr.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.15.0",
		"minecraft": "~1.21.1",
		"java": ">=21",
		"fabric-api": "*"
	}
}
